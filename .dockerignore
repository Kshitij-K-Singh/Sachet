# Build context hygiene. Transcription and OCR are hosted APIs, so no
# local model checkouts, build trees, or weight files may enter the context.

.git
.gitignore
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.venv
api/venv
api/.venv
# Test files are not COPY'd into the runtime image (Dockerfile uses an
# explicit file list), so keep them out of the build context too.
api/test_*.py

# Frontend: not part of the API image. `web` is built and served separately.
web
node_modules
**/node_modules
**/dist

# Docs and editor cruft
*.md
!api/README.md
Design Presentation Preset Configuration.pptx
.DS_Store
.idea
.vscode
**/.DS_Store

# Secrets
.env
.env.*
!.env.example

# Training checkpoints (the exported adapter is kept)
api/ml/artifacts/muril-lora/checkpoint-*
